SET DATABASE COLLATION "Spanish"
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE CACHED TABLE "Notarios"("ID" BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Caja" VARCHAR(100),"A\u00f1o" LONGVARCHAR,"Siglo" VARCHAR(10),"Notario" VARCHAR(100),"Ciudad" VARCHAR(100),"Actas" VARCHAR(100),"\u00cdndices" VARCHAR(100),"Descripci\u00f3n" LONGVARCHAR,"Observaciones" LONGVARCHAR)
SET TABLE "Notarios" INDEX'9616 64'
ALTER TABLE "Notarios" ALTER COLUMN "ID" RESTART WITH 64
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 60
